PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/task-tracker
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional: set this to any secret string. Anyone who signs up with this
# exact value in the "Admin Key" field gets created as an admin account.
# Leave blank/unset to disable admin signup entirely.
ADMIN_SIGNUP_KEY=
